POSTGRES_USER=arxiv
POSTGRES_DB=arxiv
# Create this directory with mode 0700. Required files: postgres-password,
# database-url, admin-token, qwen-worker-token, and google-client-secret.
ARXIV_SECRETS_DIR=/etc/arxiv/secrets
ARXIV_DATA_DIR=/data/arxiv
ARXIV_NETWORK_NAME=arxiv-network
# Set only when PostgreSQL is managed outside the current Compose project.
ARXIV_POSTGRES_CONTAINER=
ADMIN_EMAILS=you@example.com
GOOGLE_CLIENT_ID=
GOOGLE_REDIRECT_URL=https://arxiv.gg/auth/google/callback
GOOGLE_ANALYTICS_ID=
BING_SITE_VERIFICATION_ID=
# Keep false unless every request reaches the app through a trusted reverse proxy
# that overwrites CF-Connecting-IP and X-Forwarded-For from untrusted clients.
TRUST_PROXY_HEADERS=false
INDEXNOW_KEY=replace-with-indexnow-key
SITE_URL=https://arxiv.gg
QWEN_EMBEDDING_SERVICE_URL=
# Set true only when a monitored queue worker is actually running.
QWEN_ASYNC_WORKER_ENABLED=false
QWEN_OVH_IMAGE=
QWEN_OVH_TOKEN_VOLUME=
# Historical reference fields retained in /api/v1/stats; not a coverage calculation.
ARXIV_OFFICIAL_TOTAL_PAPERS=3045638
ARXIV_OFFICIAL_TOTAL_PAPERS_AS_OF=2026-05-16
